# Copy to .env and supply your own values. Keep existing production values on upgrade.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/swarna?replicaSet=rs0
JWT_SECRET=
SEED_EMAIL=
SEED_PASSWORD=
PUBLIC_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PREFIX=
MAX_UPLOAD_BYTES=104857600
GROQ_API_KEY=
SARVAM_API_KEY=
META_APP_SECRET=
META_PAGE_TOKEN=
META_VERIFY_TOKEN=
META_FORM_IDS=
# Page whose active lead forms should be compared against META_FORM_IDS
META_PAGE_ID=
REQUIRE_PUSH=false
FIREBASE_SERVICE_ACCOUNT_JSON=
WATCHDOG_TOKEN=

# Existing browser-based demo generator for telesales
DEMO_GENERATOR_URL=

# Manager day-end snapshot hour in India Standard Time (0–23)
DAILY_REPORT_HOUR_IST=19
