PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/swarna_crm?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
PUBLIC_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:4000
SEED_EMAIL=owner@example.com
SEED_PASSWORD=choose-a-long-private-password

# Optional: load rich demo data (leads, calls, meetings, tasks, demos) using existing Users only — no new accounts.
# SEED_DEMO=1 npm run seed:demo
# Needs at least one active user (manager preferred). Extra agent/rep users fill multi-employee scenarios; with one account all demo rows attach to that user.
# SEED_DEMO_RESET=1 removes prior demo rows (same seed phone numbers) then re-seeds; never deletes User rows.
# SEED_DEMO=1
# SEED_DEMO_RESET=
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_S3_BUCKET=
AWS_S3_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=info
GROQ_API_KEY=
SARVAM_API_KEY=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_TOKEN=
META_FORM_IDS=
GRAPH_VERSION=v23.0

# Configure Firebase Admin only on the backend, never in the app.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Required in a live deployment; makes missing push config fail readiness.
REQUIRE_PUSH=true
WATCHDOG_TOKEN=replace-with-a-separate-private-32-plus-character-token

# Optional known baseline date for first Meta backfill; blank requests all available records.
META_INITIAL_SINCE=
